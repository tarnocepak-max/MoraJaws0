# MoraJaws server / Supabase
CORS_ALLOWED_ORIGINS=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_ENABLED=

# Internal MoraJaws authentication is authoritative; do NOT configure Supabase Auth.

# Google Sheets (Google Identity Services, browser memory only)
VITE_GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_OAUTH_ACCESS_TOKEN=

# Optional sandbox/testing controls
ENABLE_SSE_SANDBOX=
SANDBOX_SUPER_ADMIN_EMAILS=
